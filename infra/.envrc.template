export ENVIRONMENT=""

# REQUIRED — what happens to resources that stop being declared in the template. No default on
# purpose: a resource can drop out for reasons that are easy to miss, and under deleteResources it is
# destroyed. deploy.sh aborts if this is unset, so every environment states its own answer instead of
# inheriting a destructive one.
#   detachAll       resources leaving the template are PRESERVED, untracked. Use for anything
#                   long-lived (shared, staging, production, anything with a public domain).
#   deleteResources resources leaving the template are DELETED. Throwaway environments only.
export ACTION_ON_UNMANAGE="detachAll"

# Azure Subscription
export AZURE_SUBSCRIPTION_ID=""
export AZURE_RESOURCE_GROUP="undp-huella-latam-$ENVIRONMENT-rg"
# Optional: Azure AD group for dev access to Key Vault and Storage (requires enableDevGroup*Access in bicepparam)
# export AZURE_SUBSCRIPTION_GROUP="Devs-Contributors"
# Note: the template's role assignments are handled automatically — deploy.sh detects whether this
# account can write them and skips exactly those resources when it cannot. Nothing to configure
# here. If it cannot write them, ACTION_ON_UNMANAGE must be detachAll or the deploy aborts, because
# dropping managed grants under deleteResources would destroy them. See
# docs/infrastructure/Deployment.md.

# Azure Entra ID — "external" (CIAM) or "organizational" (Azure AD)
export AZURE_TENANT_TYPE="external"
export AZURE_TENANT_SUBDOMAIN=""     # Only required for AZURE_TENANT_TYPE="external"
export AZURE_TENANT_ID=""
export AZURE_API_CLIENT_ID=""        # API App Registration ID
export AZURE_FRONT_CLIENT_ID=""      # Frontend App Registration ID
# Authority URL: derived from AZURE_TENANT_TYPE
if [ "$AZURE_TENANT_TYPE" = "organizational" ]; then
  export AZURE_AUTH_AUTHORITY="https://login.microsoftonline.com/${AZURE_TENANT_ID:-organizations}/v2.0"
else
  export AZURE_AUTH_AUTHORITY="https://${AZURE_TENANT_SUBDOMAIN}.ciamlogin.com/${AZURE_TENANT_ID}/v2.0"
fi

# The API's JWKS config (JWKS_ISSUER / JWKS_URI / JWKS_AUDIENCE) is derived from
# the AZURE_* values above by the deploy itself — see infra/modules/appService.bicep.
# The frontend OIDC vars are derived from AZURE_AUTH_AUTHORITY by deploy-web.sh.
# This Azure deploy path is Entra-specific; for a non-Azure IdP you would set the
# JWKS_* / VITE_OIDC_* values directly (see the root .envrc.template).

# Azure Blob Storage (configured automatically by Bicep; override here only if needed)
# export AZURE_STORAGE_ACCOUNT_NAME=""
# export AZURE_STORAGE_CONTAINER_NAME="files"

# Location 'eastus' is not available for subscriptions with free trial. Using 'eastus2' instead.
export LOCATION="eastus2"
export AUTH_PROVIDER="jwks"
export APP_VERSION=""
# Public custom domain for the frontend (bare hostname, e.g. app.example.com).
# Single source of truth: bicep propagates it to every CORS layer and the
# deploy scripts derive VITE_FRONT_BASE_URL / ALLOWED_ORIGIN from it.
# Leave empty to use Azure's default hostname.
# Details: docs/infrastructure/CustomDomainGoDaddySetup.md
export FRONTEND_CUSTOM_DOMAIN=""

# OPTIONAL — Fastify trustProxy for the API: which X-Forwarded-For senders may
# set request.ip, which is the rate limiter's bucket key. Two sources, and this
# one WINS over the other: `param apiTrustProxy` in the environment's
# params/main.<env>.bicepparam is the durable place (it survives in the
# template), while this variable overrides it for one deploy. deploy.sh warns
# only when BOTH are empty, and validates whichever supplies the value before
# the deployment starts — the API refuses to boot on a malformed one, so a typo
# here would otherwise become a crash-looping container.
#
# Reaches the container as the TRUST_PROXY app setting — the names differ, so it
# is TRUST_PROXY you look for in the App Service configuration, not this one.
#
#   <empty>   not configured. Behind a proxy this makes the 100 req/min limit ONE
#             bucket shared by every caller, per instance.
#   1         App Service alone (enableFrontDoor = false)
#   2         App Service behind Front Door (enableFrontDoor = true)
#   false     records that this deployment really is reached directly, and
#             silences the boot warning
#   <ip/cidr>[,...]  an explicit allowlist, e.g. "10.0.0.0/8,192.168.0.0/16"
#
# Pick it from the real request path, not by guessing: too few hops keeps the
# shared bucket, too many let a caller forge X-Forwarded-For and choose its own.
# Per-topology guidance: docs/security/hardening.md ("Proxy Trust").
# export API_TRUST_PROXY=""

export DRY_RUN="false"

# Web app: set to "true" to enable demo mode in the frontend
# export VITE_IS_DEMO_APP=""

# VITE_API_BASE_URL is auto-resolved from the API App Service hostname by
# deploy-web.sh. Override only when pointing to a custom domain for the API.
# Note: VITE_FRONT_BASE_URL is intentionally NOT exposed here — deploy-web.sh
# derives it from FRONTEND_CUSTOM_DOMAIN to stay aligned with bicep's CORS
# config. A manual override would create a CORS mismatch.
# export VITE_API_BASE_URL="https://api.huella-test.com/api"
