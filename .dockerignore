# This is a root-level .dockerignore template
# If building from project root, copy this to the root directory

# Dependencies
**/node_modules
**/.pnpm-store
.pnpm-store

# Build outputs
**/dist
**/.turbo
.turbo
**/*.tsbuildinfo

# Development files
**/.env
**/.env.local
**/.env.development
**/.env.test

# Testing
**/coverage
**/.vitest

# IDE
.vscode
.idea
**/*.swp
**/*.swo
**/*~

# Logs
**/logs
**/*.log

# OS files
.DS_Store
**/Thumbs.db

# Git
.git
.gitignore

# Documentation
**/*.md
# ...except seed data markdown: explanation content read by @repo/seed at runtime
!tools/seed/src/data/**/*.md
# ...and the chatbot system prompt, which is program input rather than
# documentation: apps/api reads it at runtime and its `build` script copies it
# into dist. Excluding it produced an api image that crashed on startup.
!apps/api/src/features/chatbot/prompts/**/*.md
docs

# Infra
infra

# Rest client files
**/*.rest

# Test files
**/test
**/*.test.ts
**/*.spec.ts
**/vitest.config.ts

