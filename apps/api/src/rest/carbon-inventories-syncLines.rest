### Error Case - Line belongs to different inventory
# First create a line in inventory 2, then try to update it via inventory 1
POST {{baseUrl}}/api/carbon-inventories/1/lines/sync HTTP/1.1
Content-Type: application/json

{
  "create": [],
  "update": [
    {
      "id": "100",
      "inputType": "SIMPLIFIED",
      "dimensionValue1Id": null,
      "dimensionValue2Id": null,
      "measurementUnitId": null,
      "quantity": null,
      "factorSelection": null,
      "comment": "This should fail - line from different inventory"
    }
  ],
  "delete": []
}


### Error Case - Catalog factor that is not in this methodology
# Returns 422 CATALOG_EMISSION_FACTOR_NOT_IN_METHODOLOGY. The same shape returns
# 404 CATALOG_EMISSION_FACTOR_NOT_FOUND when the factor was retired.
POST {{baseUrl}}/api/carbon-inventories/1/lines/sync HTTP/1.1
Content-Type: application/json

{
  "create": [],
  "update": [
    {
      "id": "1",
      "inputType": "SIMPLIFIED",
      "dimensionValue1Id": "1",
      "dimensionValue2Id": null,
      "measurementUnitId": "1",
      "quantity": 10,
      "factorSelection": {
        "type": "CATALOG",
        "emissionFactorId": "999999",
        "appliedRateMeasurementUnitId": "1"
      },
      "comment": "This should fail - factor from another methodology"
    }
  ],
  "delete": []
}


### Error Case - UNCHANGED on a create
# Rejected at the schema: a line being created has no snapshot to keep, so the
# variant is not part of the create union.
POST {{baseUrl}}/api/carbon-inventories/1/lines/sync HTTP/1.1
Content-Type: application/json

{
  "create": [
    {
      "subcategoryId": "1",
      "inputType": "SIMPLIFIED",
      "dimensionValue1Id": null,
      "dimensionValue2Id": null,
      "measurementUnitId": null,
      "quantity": null,
      "factorSelection": { "type": "UNCHANGED" },
      "comment": null
    }
  ],
  "update": [],
  "delete": []
}


