### Sync Lines - Update everything except the factor
# The quantity changes but the factor does not, so the line keeps the exact
# snapshot it already had: same value, unit, source, year and catalog id. The
# catalog is not consulted, which is why this still works after the factor has
# been edited or retired.
POST {{baseUrl}}/api/carbon-inventories/1/lines/sync HTTP/1.1
Content-Type: application/json

{
  "create": [],
  "update": [
    {
      "id": "1",
      "inputType": "SIMPLIFIED",
      "dimensionValue1Id": "2",
      "dimensionValue2Id": null,
      "measurementUnitId": "1",
      "quantity": 999.5,
      "factorSelection": { "type": "UNCHANGED" },
      "comment": "Only the quantity changed"
    }
  ],
  "delete": []
}


